# Gemini API key. Copy this file to config/.env and fill it.
GEMINI_API_KEY=
# Optional overrides:
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# BUDGET_CAP_USD_PER_DAY=1.0

# DeepSeek (OpenAI-compatible) remains available as a fallback provider:
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# LinkedIn credentials, used only when the persistent LinkedIn session has
# expired and the bot must re-authenticate to log in to Gupy:
# LINKEDIN_USERNAME=you@example.com
# LINKEDIN_PASSWORD=your-password

# Which provider answers the model calls: gemini | deepseek. Leave it unset to use
# whichever key is present (Gemini first). When the active provider rejects the key
# or has no credit, the client switches to the other one once and keeps using it.
# JFA_PROVIDER=deepseek

# --- Mail (reads the inboxes for one-time codes and job mail) -----------------
# App passwords do NOT belong in this file. Put them in config/mail.env, which is
# dedicated to them, git-ignored, and read automatically after this file.
# Two accounts are configured in config/settings.yaml (mail.accounts).
#
# OAuth instead of app passwords: save a Desktop OAuth client JSON (Gmail API
# enabled) to config/gmail-oauth-client.json, set the account's backend to
# "oauth" in settings.yaml, then run: npm run mail -- auth <account>
